# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local      (or run: npm run set-key)
#
# Corti Models auth: OAuth2 client credentials, sent out-of-band.
CORTI_TENANT_NAME=base
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=
CORTI_ENVIRONMENT=eu

# Alternative: a static bearer token (takes precedence if set)
# CORTI_API_KEY=

# Mock CRM server host/port (Node reads these via process.env)
CRM_PORT=3001
CRM_HOST=localhost
