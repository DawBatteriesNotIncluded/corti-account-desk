{
  "name": "gtm-engineer-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GTM Engineer take-home challenge",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx mock-crm/server.ts",
    "crm": "node --env-file-if-exists=.env.local --import tsx mock-crm/server.ts",
    "start": "npm run dev",
    "test": "node --env-file-if-exists=.env.local --import tsx --test tests/starter.test.ts tests/corti-auth.test.ts tests/book.test.ts",
    "challenge": "node --env-file-if-exists=.env.local --import tsx src/candidate/index.ts",
    "ask": "node --env-file-if-exists=.env.local --import tsx scripts/ask.ts",
    "brief":"node --env-file-if-exists=.env.local --import tsx src/brief.ts",
    "corti:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-corti.ts",
    "set-key": "node --import tsx scripts/set-corti-key.ts && npm run corti:check"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
